# Copie para front/.env.local. Não versione o .env.local.

# Base das chamadas da SPA. Com o valor padrão, o Vite (dev/preview) ou o nginx (produção)
# encaminha /api ao backend, no mesmo domínio.
VITE_API_URL=/api

# Endereço do backend usado pelo encaminhamento do servidor do Vite (vite.config.ts).
API_PROXY_URL=http://localhost:3000
