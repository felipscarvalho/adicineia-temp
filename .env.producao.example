# Copie para .env na raiz (não versionar) e preencha antes de "docker compose up -d --build".
# Use senhas só com letras e números (vão dentro de URLs de conexão).
# Mínimos: SENHA_BANCO_APP com 12 caracteres; SEED_SENHA_* com 8.
# POSTGRES_PASSWORD só vale na criação do volume do banco; para trocá-la depois, altere no Postgres.

DOMINIO=es.felipscarvalho.com.br
# E-mail para avisos do Let's Encrypt (obrigatório para emitir o certificado)
LETSENCRYPT_EMAIL=
# 1 = ambiente de testes do Let's Encrypt (certificado não confiável, sem limite de emissões)
CERTBOT_STAGING=0

POSTGRES_USER=dataqualisus
POSTGRES_DB=dataqualisus
# Dono do esquema: usado só pela migração
POSTGRES_PASSWORD=
# Usuário dataqualisus_app, com privilégios mínimos, usado pela API (ADR-006); mínimo de 12 caracteres
SENHA_BANCO_APP=

BCRYPT_CUSTO=12
SESSAO_DURACAO_MINUTOS=480
SIMULACAO_LIMITE_MS=60000
SIMULACAO_POOL_TAMANHO=2

# Contas de demonstração (analista@, gestor@, equipe.tecnica@dataqualisus.local).
# Se preenchidas (mínimo de 8 caracteres), são criadas ou têm a senha redefinida a cada subida;
# vazias, nada muda.
SEED_SENHA_ANALISTA=
SEED_SENHA_GESTOR=
SEED_SENHA_EQUIPE_TECNICA=

# Portas publicadas no servidor
PORTA_HTTP=80
PORTA_HTTPS=443
